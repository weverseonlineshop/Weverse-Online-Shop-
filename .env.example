# ═══════════════════════════════════════════════════════════════
# K.C.O Global Online Marketplace — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to ".env" and fill in your values.
# Variables prefixed with VITE_ are exposed to the browser (client-side).
# Variables without the VITE_ prefix are server-side only (edge functions).
# NEVER commit your real .env file to version control.
# ═══════════════════════════════════════════════════════════════

# ── SUPABASE (pre-configured — do not change) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase keys (used by edge functions — already set in Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_DB_URL=postgresql://...

# ── FLUTTERWAVE (payments) ─────────────────────────────────────
# Get these from https://dashboard.flutterwave.com/dashboard/settings/apis
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here
FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key-here
FLW_ENCRYPTION_KEY=FLWSECK_TEST-your-encryption-key-here

# ── RESEND (transactional emails) ─────────────────────────────
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# ── SENDER EMAIL ADDRESSES ────────────────────────────────────
# Two professional sender addresses — the edge functions automatically
# select the correct one based on the email type.
#
# FROM_EMAIL_SYSTEM (noreply@) — used for:
#   Account verification, password reset, 2FA codes, login alerts,
#   security notifications, system notifications, AI-generated emails.
#
# FROM_EMAIL_SUPPORT (support@) — used for:
#   Order confirmations, payment confirmations, shipping & delivery
#   updates, customer support replies, contact form responses,
#   marketplace notifications, general customer communications.
#
# Backward compatible: if these are unset, the legacy FROM_EMAIL var
# is used as a fallback for both.
FROM_EMAIL_SYSTEM=K.C.O Global Online Marketplace <noreply@kcoglobalonlinemarket.com>
FROM_EMAIL_SUPPORT=K.C.O Global Online Marketplace <support@kcoglobalonlinemarket.com>

# ── GOOGLE ANALYTICS ───────────────────────────────────────────
# Measurement ID from https://analytics.google.com (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── FIREBASE CLOUD MESSAGING (push notifications) ──────────────
# Client-side config: Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
# VAPID key from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=YOUR_FIREBASE_VAPID_KEY

# Server-side config: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Download the JSON key file. Copy these three fields into the Supabase Edge Function secrets:
#   FIREBASE_PROJECT_ID  → "project_id" field
#   FIREBASE_CLIENT_EMAIL → "client_email" field
#   FIREBASE_PRIVATE_KEY → "private_key" field (keep the \n escape sequences as-is)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY

# ── OPENAI (AI assistant) ──────────────────────────────────────
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
