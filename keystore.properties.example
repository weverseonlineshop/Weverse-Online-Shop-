# Keystore properties for signing the Android release build
# Copy this file to keystore.properties and fill in your values
# DO NOT commit keystore.properties to version control
#
# To generate a keystore:
#   keytool -genkey -v -keystore kco-release.keystore -alias kco-release -keyalg RSA -keysize 2048 -validity 10000
#
# Then fill in the values below:
storeFile=kco-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=kco-release
keyPassword=YOUR_KEY_PASSWORD
